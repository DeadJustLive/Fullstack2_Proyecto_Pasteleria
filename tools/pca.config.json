{
  "_annotation": {
    "id": "tools.pca_config",
    "kind": "config",
    "desc": "Manifiesto del anotador PCA (JSON no admite comentarios; esta clave cumple el rol de bloque)",
    "relates": [
      "tools.pca_annotator",
      "tools.pca_core"
    ]
  },
  "base_dir": "..",
  "roots": [
    "docs",
    "tools",
    "frontend/src",
    "frontend/scripts",
    "admin-pwa/src",
    "backend"
  ],
  "include": [
    "**/*.py",
    "**/*.md",
    "**/*.css",
    "**/*.html",
    "**/*.tsx",
    "**/*.ts",
    "**/*.mjs",
    "**/*.java"
  ],
  "exclude": [
    "**/grafo.*",
    "**/*.bak",
    "**/node_modules/**",
    "**/dist/**",
    "**/target/**",
    "**/__pycache__/**"
  ],
  "files": [
    {
      "path": "tools/pca_annotator.py",
      "id": "tools.pca_annotator",
      "kind": "service",
      "limit": 250,
      "contract": "cli: annotate|graph|impact|check|selftest",
      "desc": "CLI para inyectar anotaciones PCA, generar el grafo de impacto, detectar deriva y autoevaluarse",
      "relates": [
        "tools.pca_core",
        "tools.pca_selftest",
        "tools.readme",
        "docs.sistema_anotaciones",
        "docs.convenciones"
      ]
    },
    {
      "path": "tools/pca_core.py",
      "id": "tools.pca_core",
      "kind": "service",
      "limit": 430,
      "contract": "core: load_config, annotate_file, build_graph, compute_impact, find_drift",
      "desc": "Núcleo puro del anotador PCA: manifiesto, bloques, grafo e impacto sin CLI",
      "relates": [
        "tools.pca_annotator",
        "tools.pca_selftest"
      ]
    },
    {
      "path": "tools/pca_selftest.py",
      "id": "tools.pca_selftest",
      "kind": "test",
      "limit": 380,
      "contract": "run_selftest(): (passed, failures)",
      "desc": "Pruebas doradas del anotador PCA: parser, inyección, grafo, impacto, deriva y códigos de salida",
      "relates": [
        "tools.pca_core",
        "tools.pca_annotator"
      ]
    },
    {
      "path": "tools/README.md",
      "id": "tools.readme",
      "kind": "doc",
      "desc": "Guía de uso del anotador PCA y cómo agregar lenguajes",
      "relates": [
        "tools.pca_annotator"
      ]
    },
    {
      "path": "docs/sistema_anotaciones.md",
      "id": "docs.sistema_anotaciones",
      "kind": "doc",
      "desc": "Diccionario de anotaciones PCA y cómo usarlas",
      "relates": [
        "tools.pca_annotator"
