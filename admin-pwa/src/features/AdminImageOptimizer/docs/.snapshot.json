      "path": "admin-pwa/src/features/AdminImageOptimizer/implementation/AdminImageOptimizer.view.tsx",
      "id": "feature.adminimageoptimizer.view",
      "kind": "view",
      "contract": "AdminImageOptimizerView(props: AdminImageOptimizerContract)",
