# ==============================================================================
# PASTELERÍA CRÈMÉ & CO — VARIABLES DE ENTORNO DE PRODUCCIÓN (VPS / DOCKER)
# ==============================================================================
# Copie este archivo como .env en la raíz antes de desplegar en producción:
# cp .env.example .env

# --- ENTORNO Y DOMINIOS ---
NODE_ENV=production
DOMAIN_NAME=pasteleriacremeco.cl
STORE_URL=https://pasteleriacremeco.cl
ADMIN_URL=https://admin.pasteleriacremeco.cl
API_GATEWAY_URL=https://api.pasteleriacremeco.cl

# --- BASE DE DATOS MYSQL 8 ---
MYSQL_HOST=mysql-db
MYSQL_PORT=3306
MYSQL_DATABASE=cremeco_db
MYSQL_USER=cremeco_user
MYSQL_PASSWORD=CremeCo2026_SecurePass!
MYSQL_ROOT_PASSWORD=Root2026_UltraSecure!
SPRING_DATASOURCE_URL=jdbc:mysql://mysql-db:3306/cremeco_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=America/Santiago&characterEncoding=UTF-8

# --- BROKER KAFKA & ZOOKEEPER ---
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_HOST=kafka
KAFKA_PORT=9092

# --- CACHÉ REDIS ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- PASARELA DE PAGOS FLOW CHILE ---
FLOW_API_URL=https://sandbox.flow.cl/api
FLOW_API_KEY=FLOW_SANDBOX_API_KEY_CREMECO
FLOW_SECRET_KEY=FLOW_SANDBOX_SECRET_KEY_CREMECO
FLOW_URL_CONFIRMATION=https://api.pasteleriacremeco.cl/api/payments/flow/confirm
FLOW_URL_RETURN=https://pasteleriacremeco.cl/pago/exito

# --- MICROSERVICIOS SPRING BOOT (RUTAS API GATEWAY) ---
SERVICE_IDENTITY_URL=http://service-identity:8081
SERVICE_CATALOG_URL=http://service-catalog:8082
SERVICE_ORDER_URL=http://service-order:8083
SERVICE_PAYMENT_URL=http://service-payment-flow:8084
SERVICE_INVENTORY_URL=http://service-inventory:8085
SERVICE_NOTIFICATION_URL=http://service-notification:8086
